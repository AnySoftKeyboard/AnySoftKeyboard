<?xml version="1.0" encoding="utf-8"?>
<!--
    Zhuyin (注音 / Bopomofo) layout: ㄅㄆㄇㄈ symbols are the primary key labels;
    a long-press gives the key's hint (the digit or Latin key at that place)
    and, next to it, the Bopomofo symbol itself as plain text (popup keys are
    not composed). The bottom row has no keyboardMode, so it is used in every
    field type (URL and e-mail fields too). Codes are Bopomofo Unicode
    codepoints (U+3105..U+3129, plus tone marks U+02C7/02CA/02CB/02D9), which
    the Zhuyin composer (ime/phonetic) turns into syllables and converts to
    Hanzi sentences.

    Mapping follows the standard 大千 (Dachen) Bopomofo keyboard layout.
    The top row is the row that on a US-QWERTY keyboard holds the digit row;
    in 大千 it carries ㄅ ㄉ ˇ ˋ ㄓ ˊ ˙ ㄚ ㄞ ㄢ; the digits themselves remain
    available via long-press.

    Ortholinear grid: four rows of ten equal keys in aligned
    columns. ㄦ and backspace live in the bottom row; ？ and 「 are long-presses
    on ， and 。. (The "注音 ，。" keyboard keeps the classic 11-column rows.)

    autoCap is disabled because Bopomofo radicals are single-character labels;
    auto-cap would otherwise shift the keyboard view and (for theme renderers
    that fall back to the key code) display the underlying numeric codes.

    keyHeight comes from chinese_traditional_zhuyin_key_height (compact): the
    four Bopomofo rows take the same height as three normal QWERTY rows, so
    this keyboard is no taller than the English one.
-->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ask="http://schemas.android.com/apk/res-auto"
    android:keyWidth="10%p"
    android:keyHeight="@integer/chinese_traditional_zhuyin_key_height"
    ask:autoCap="false">

    <Row>
        <Key android:codes="12549" android:keyLabel="ㄅ"
             android:popupCharacters="1ㄅ" ask:hintLabel="1"
             android:keyEdgeFlags="left"/>
        <Key android:codes="12553" android:keyLabel="ㄉ"
             android:popupCharacters="2ㄉ" ask:hintLabel="2"/>
        <Key android:codes="711"   android:keyLabel="ˇ"
             android:popupCharacters="3ˇ" ask:hintLabel="3"/>
        <Key android:codes="715"   android:keyLabel="ˋ"
             android:popupCharacters="4ˋ" ask:hintLabel="4"/>
        <Key android:codes="12563" android:keyLabel="ㄓ"
             android:popupCharacters="5ㄓ" ask:hintLabel="5"/>
        <Key android:codes="714"   android:keyLabel="ˊ"
             android:popupCharacters="6ˊ" ask:hintLabel="6"/>
        <Key android:codes="729"   android:keyLabel="˙"
             android:popupCharacters="7˙" ask:hintLabel="7"/>
        <Key android:codes="12570" android:keyLabel="ㄚ"
             android:popupCharacters="8ㄚ" ask:hintLabel="8"/>
        <Key android:codes="12574" android:keyLabel="ㄞ"
             android:popupCharacters="9ㄞ" ask:hintLabel="9"/>
        <Key android:codes="12578" android:keyLabel="ㄢ"
             android:popupCharacters="0ㄢ" ask:hintLabel="0"
             android:keyEdgeFlags="right"/>
    </Row>

    <Row>
        <Key android:codes="12550" android:keyLabel="ㄆ"
             android:popupCharacters="qㄆｑ" ask:hintLabel="q"
             android:keyEdgeFlags="left"/>
        <Key android:codes="12554" android:keyLabel="ㄊ"
             android:popupCharacters="wㄊｗ" ask:hintLabel="w"/>
        <Key android:codes="12557" android:keyLabel="ㄍ"
             android:popupCharacters="eㄍｅ" ask:hintLabel="e"/>
        <Key android:codes="12560" android:keyLabel="ㄐ"
             android:popupCharacters="rㄐｒ" ask:hintLabel="r"/>
        <Key android:codes="12564" android:keyLabel="ㄔ"
             android:popupCharacters="tㄔｔ" ask:hintLabel="t"/>
        <Key android:codes="12567" android:keyLabel="ㄗ"
             android:popupCharacters="yㄗｙ" ask:hintLabel="y"/>
        <Key android:codes="12583" android:keyLabel="ㄧ"
             android:popupCharacters="uㄧｕ" ask:hintLabel="u"/>
        <Key android:codes="12571" android:keyLabel="ㄛ"
             android:popupCharacters="iㄛｉ" ask:hintLabel="i"/>
        <Key android:codes="12575" android:keyLabel="ㄟ"
             android:popupCharacters="oㄟｏ" ask:hintLabel="o"/>
        <Key android:codes="12579" android:keyLabel="ㄣ"
             android:popupCharacters="pㄣｐ" ask:hintLabel="p"
             android:keyEdgeFlags="right"/>
    </Row>

    <Row>
        <Key android:codes="12551" android:keyLabel="ㄇ"
             android:popupCharacters="aㄇ\@ａ" ask:hintLabel="a"
             android:keyEdgeFlags="left"/>
        <Key android:codes="12555" android:keyLabel="ㄋ"
             android:popupCharacters="sㄋ#ｓ" ask:hintLabel="s"/>
        <Key android:codes="12558" android:keyLabel="ㄎ"
             android:popupCharacters="dㄎ&amp;ｄ" ask:hintLabel="d"/>
        <Key android:codes="12561" android:keyLabel="ㄑ"
             android:popupCharacters="fㄑ*ｆ" ask:hintLabel="f"/>
        <Key android:codes="12565" android:keyLabel="ㄕ"
             android:popupCharacters="gㄕ-ｇ" ask:hintLabel="g"/>
        <Key android:codes="12568" android:keyLabel="ㄘ"
             android:popupCharacters="hㄘ+ｈ" ask:hintLabel="h"/>
        <Key android:codes="12584" android:keyLabel="ㄨ"
             android:popupCharacters="jㄨ=ｊ" ask:hintLabel="j"/>
        <Key android:codes="12572" android:keyLabel="ㄜ"
             android:popupCharacters="kㄜ(ｋ" ask:hintLabel="k"/>
        <Key android:codes="12576" android:keyLabel="ㄠ"
             android:popupCharacters="lㄠ)ｌ" ask:hintLabel="l"/>
        <Key android:codes="12580" android:keyLabel="ㄤ"
             android:popupCharacters=";ㄤ:" ask:hintLabel=";"
             android:keyEdgeFlags="right"/>
    </Row>

    <Row>
        <Key android:codes="12552" android:keyLabel="ㄈ"
             android:popupCharacters="zㄈ!%[\\]^`{|}~ｚ"
             ask:hintLabel="z"
             android:keyEdgeFlags="left"/>
        <Key android:codes="12556" android:keyLabel="ㄌ"
             android:popupCharacters="xㄌ$ｘ" ask:hintLabel="x"/>
        <Key android:codes="12559" android:keyLabel="ㄏ"
             android:popupCharacters="cㄏ&quot;ｃ" ask:hintLabel="c"/>
        <Key android:codes="12562" android:keyLabel="ㄒ"
             android:popupCharacters="vㄒ\'ｖ" ask:hintLabel="v"/>
        <Key android:codes="12566" android:keyLabel="ㄖ"
             android:popupCharacters="bㄖ:ｂ" ask:hintLabel="b"/>
        <Key android:codes="12569" android:keyLabel="ㄙ"
             android:popupCharacters="nㄙ;ｎ" ask:hintLabel="n"/>
        <Key android:codes="12585" android:keyLabel="ㄩ"
             android:popupCharacters="mㄩ/ｍ" ask:hintLabel="m"/>
        <Key android:codes="12573" android:keyLabel="ㄝ"
             android:popupCharacters=",ㄝ&lt;" ask:hintLabel=","/>
        <Key android:codes="12577" android:keyLabel="ㄡ"
             android:popupCharacters=".ㄡ&gt;" ask:hintLabel="."/>
        <Key android:codes="12581" android:keyLabel="ㄥ"
             android:popupCharacters="/ㄥ\?" ask:hintLabel="/"
             android:keyEdgeFlags="right"/>
    </Row>
    <!-- Bottom row: ☺ ， 。 space ㄦ ⌫ ⏎ (provided by the layout). -->
    <Row android:rowEdgeFlags="bottom" android:keyWidth="10%p"
         android:keyHeight="@integer/key_normal_height">
        <Key ask:isFunctional="true" android:codes="@integer/key_code_quick_text"
             ask:longPressCode="@integer/key_code_quick_text_popup" android:keyEdgeFlags="left"/>
        <Key android:codes="65292" android:keyLabel="，" android:popupCharacters="？、；：！"/>
        <Key android:codes="12290" android:keyLabel="。" android:popupCharacters="「」『』…～·"/>
        <Key ask:isFunctional="true" android:codes="@integer/key_code_space" android:keyWidth="30%p"/>
        <Key android:codes="12582" android:keyLabel="ㄦ" android:popupCharacters="-ㄦ_" ask:hintLabel="-"/>
        <Key android:codes="-5" android:keyWidth="15%p" android:isRepeatable="true"/>
        <Key ask:isFunctional="true" android:codes="@integer/key_code_enter" android:keyWidth="15%p"
             android:keyEdgeFlags="right" ask:longPressCode="@integer/key_code_settings"/>
    </Row>
</Keyboard>
