<?xml version="1.0" encoding="utf-8"?>
<!-- Zhuyin 倚天 (ETen) 41-key layout. Keys emit Bopomofo; the hint is the ETen Latin key.
     A long-press gives the hint and, next to it, the Bopomofo symbol itself as plain text. -->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ask="http://schemas.android.com/apk/res-auto"
    android:keyWidth="10%p"
    android:keyHeight="@integer/chinese_traditional_zhuyin_key_height"
    ask:autoCap="false">
    <Row>
        <Key android:codes="729"
             android:keyLabel="˙"
             android:keyWidth="10%p"
             android:popupCharacters="1˙"
             ask:hintLabel="1"
             android:keyEdgeFlags="left"/>
        <Key android:codes="714"
             android:keyLabel="ˊ"
             android:keyWidth="10%p"
             android:popupCharacters="2ˊ"
             ask:hintLabel="2"/>
        <Key android:codes="711"
             android:keyLabel="ˇ"
             android:keyWidth="10%p"
             android:popupCharacters="3ˇ"
             ask:hintLabel="3"/>
        <Key android:codes="715"
             android:keyLabel="ˋ"
             android:keyWidth="10%p"
             android:popupCharacters="4ˋ"
             ask:hintLabel="4"/>
        <Key android:codes="12561"
             android:keyLabel="ㄑ"
             android:keyWidth="10%p"
             android:popupCharacters="7ㄑ"
             ask:hintLabel="7"/>
        <Key android:codes="12578"
             android:keyLabel="ㄢ"
             android:keyWidth="10%p"
             android:popupCharacters="8ㄢ"
             ask:hintLabel="8"/>
        <Key android:codes="12579"
             android:keyLabel="ㄣ"
             android:keyWidth="10%p"
             android:popupCharacters="9ㄣ"
             ask:hintLabel="9"/>
        <Key android:codes="12580"
             android:keyLabel="ㄤ"
             android:keyWidth="10%p"
             android:popupCharacters="0ㄤ"
             ask:hintLabel="0"/>
        <Key android:codes="12581"
             android:keyLabel="ㄥ"
             android:keyWidth="10%p"
             android:popupCharacters="-ㄥ"
             ask:hintLabel="-"/>
        <Key android:codes="12582"
             android:keyLabel="ㄦ"
             android:keyWidth="10%p"
             android:popupCharacters="=ㄦ"
             ask:hintLabel="="
             android:keyEdgeFlags="right"/>
    </Row>

    <Row>
        <Key android:codes="12575"
             android:keyLabel="ㄟ"
             android:keyWidth="10%p"
             android:popupCharacters="qㄟ"
             ask:hintLabel="q"
             android:keyEdgeFlags="left"/>
        <Key android:codes="12573"
             android:keyLabel="ㄝ"
             android:keyWidth="10%p"
             android:popupCharacters="wㄝ"
