        <Key android:codes="12550"
             android:keyLabel="ㄆ"
             android:keyWidth="10%p"
             android:popupCharacters="pㄆ"
             ask:hintLabel="p"
             android:keyEdgeFlags="right"/>
    </Row>

    <Row>
        <Key android:codes="12570"
             android:keyLabel="ㄚ"
             android:keyWidth="9.09%p"
             android:popupCharacters="aㄚ"
             ask:hintLabel="a"
             android:keyEdgeFlags="left"/>
        <Key android:codes="12569"
             android:keyLabel="ㄙ"
             android:keyWidth="9.09%p"
             android:popupCharacters="sㄙ"
             ask:hintLabel="s"/>
        <Key android:codes="12553"
             android:keyLabel="ㄉ"
             android:keyWidth="9.09%p"
