             ask:hintLabel="e"/>
        <Key android:codes="12572"
             android:keyLabel="ㄜ"
             android:keyWidth="10%p"
             android:popupCharacters="rㄜ"
             ask:hintLabel="r"/>
        <Key android:codes="12554"
             android:keyLabel="ㄊ"
             android:keyWidth="10%p"
             android:popupCharacters="tㄊ"
             ask:hintLabel="t"/>
        <Key android:codes="12577"
             android:keyLabel="ㄡ"
             android:keyWidth="10%p"
             android:popupCharacters="yㄡ"
             ask:hintLabel="y"/>
        <Key android:codes="12585"
             android:keyLabel="ㄩ"
             android:keyWidth="10%p"
             android:popupCharacters="uㄩ"
             ask:hintLabel="u"/>
        <Key android:codes="12574"
             android:keyLabel="ㄞ"
             android:keyWidth="10%p"
             android:popupCharacters="iㄞ"
