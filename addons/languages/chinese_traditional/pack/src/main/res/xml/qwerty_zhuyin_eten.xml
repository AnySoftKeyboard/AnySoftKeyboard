             android:keyWidth="9.09%p"
             android:popupCharacters="\'ㄘ"
             ask:hintLabel="\'"
             android:keyEdgeFlags="right"/>
    </Row>

    <Row>
        <Key android:codes="12576"
             android:keyLabel="ㄠ"
             android:keyWidth="8.8%p"
             android:popupCharacters="zㄠ"
             ask:hintLabel="z"
             android:keyEdgeFlags="left"/>
        <Key android:codes="12584"
             android:keyLabel="ㄨ"
             android:keyWidth="8.8%p"
