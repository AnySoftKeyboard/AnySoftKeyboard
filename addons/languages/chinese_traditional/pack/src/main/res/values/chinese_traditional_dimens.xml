<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Four-row Zhuyin layouts (大千, 倚天, 注音 ，。) use compact keys: four Bopomofo rows take
         the same height as three normal letter rows, so the keyboard is as tall as QWERTY in
         both orientations. Three-row layouts (許氏, 倚天26) use key_normal_height directly. -->
    <integer name="chinese_traditional_zhuyin_key_height">@integer/key_compact_height</integer>
</resources>
