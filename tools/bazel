#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HELPER_SCRIPT="${SCRIPT_DIR}/hermetiq-credential-helper.sh"

# If the helper script file exists on disk, add --config=hermetiq to build commands
if [[ -f "${HELPER_SCRIPT}" ]]; then
  args=()
  inserted=false

  is_ci=false
  case "${CI:-}" in
    true|TRUE|1)
      is_ci=true
      ;;
  esac

  for arg in "$@"; do
    args+=("${arg}")
    if [[ "${inserted}" == false ]]; then
      case "${arg}" in
        build|test|run|coverage|cquery|aquery|info|clean|mobile-install)
          args+=("--config=hermetiq")
          if [[ "${is_ci}" == true ]]; then
            args+=("--remote_download_minimal")
          fi
          inserted=true
          ;;
      esac
    fi
  done

  exec "${BAZEL_REAL}" "${args[@]}"
else
  exec "${BAZEL_REAL}" "$@"
fi
